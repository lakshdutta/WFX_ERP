# Supabase Connection URL (Direct PostgreSQL Connection String)
# Example: postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=

# Supabase REST API Connection (Optional if DATABASE_URL is provided)
SUPABASE_URL=
SUPABASE_KEY=

# LLM Keys for Text-to-SQL (Vanna AI integration)
# Vanna AI can run using OpenAI GPT-4, Anthropic, or its free tier
OPENAI_API_KEY=
VANNA_API_KEY=

# Server Port
PORT=8000
